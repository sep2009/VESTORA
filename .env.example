# Public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# AI provider key, used only in server route handlers (added in the AI stage)
ANTHROPIC_API_KEY=
# Payments (added in the checkout stage)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Admin dashboard (server-only; never NEXT_PUBLIC_)
# SESSION_SECRET: at least 32 random characters.   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# ADMIN_PASSWORD_HASH: from  node scripts/hash-password.mjs "a long password"
ADMIN_PASSWORD_HASH=
# Optional second role with fewer permissions (products, stock, uploads only)
EDITOR_PASSWORD_HASH=

# Payments. Stripe is used when BOTH are set (hosted Checkout; card data never reaches this server).
# STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET are listed above. Point a Stripe webhook at  <site>/api/payments/webhook/stripe
# for checkout.session.completed, .async_payment_succeeded, .async_payment_failed and .expired.
# Test sandbox (NO real money): set a long random PAYMENT_WEBHOOK_SECRET. In production it also needs ALLOW_TEST_PAYMENTS=1.
PAYMENT_WEBHOOK_SECRET=
ALLOW_TEST_PAYMENTS=

# Virtual try-on. TRYON_PROVIDER names an adapter in src/server/tryon/providers/index.ts. NO real adapter exists yet (see docs/TRYON.md).
# Leave empty: AI photo try-on is shown as unavailable (avatar preview and 3D garment preview still work).
# "test" = development test provider (creates a labelled placeholder image, no AI). In production it also needs ALLOW_TEST_TRYON=1.
TRYON_PROVIDER=
ALLOW_TEST_TRYON=
# Optional limits: TRYON_DAILY_LIMIT (default 10 per customer per 24 h), TRYON_RATE_PER_HOUR (default 20 upload requests per IP),
# TRYON_TIMEOUT_MS (default 120000), TRYON_POLL_MS (default 1000). Private photo storage: VESTORA_PRIVATE_DIR (default data/private).

# Stylist assistant. The rule-based stylist always works. ASSISTANT_PROVIDER names a language-model adapter in
# src/server/assistant/providers/index.ts. NO real adapter exists yet (see docs/ASSISTANT.md). Leave empty to use the built-in rules.
# "test" = scripted development provider (NOT an AI model). In production it also needs ALLOW_TEST_ASSISTANT=1.
ASSISTANT_PROVIDER=
ALLOW_TEST_ASSISTANT=
# Optional: ASSISTANT_TIMEOUT_MS (default 20000), ASSISTANT_RATE_PER_MIN (default 30 per IP).
